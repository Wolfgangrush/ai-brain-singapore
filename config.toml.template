# AI Brain — Singapore · config.toml
# Generated by setup.sh. Customize as needed.

[jurisdiction]
country = "Singapore"
citation_format = "Singapore neutral citations"        # e.g. "[2025] SGHC 123"
court_hierarchy = "../singapore/_court_hierarchy.json"  # path to a JSON map of courts
bar_rules = "../singapore/_bar_rules.md"                # path to bar-rules markdown (LSRA)
timezone = "Asia/Singapore"

[paths]
statute_corpus = "../singapore/_statute_corpus/"
drafting_corpus = "../singapore/_drafting_data/"
audit_log_dir = "~/.ailawfirm_singapore/audit_logs/"
matter_root = "~/.ailawfirm_singapore/matters/"

[llm]
provider = "claude"                                      # v0.1 only supports claude
# In v0.3+: "openai" · "gemini_paid" · "ollama" · "byom"
